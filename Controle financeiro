    <script>
        // ============================================================
        //  CONFIGURAÇÃO DO FIREBASE - SUAS CREDENCIAIS
        // ============================================================
        const firebaseConfig = {
            apiKey: "AIzaSyB6eWS-N2hacE2Uyn5gCwf6m1P169T_y_4",
            authDomain: "controle-financeiro-60807.firebaseapp.com",
            projectId: "controle-financeiro-60807",
            storageBucket: "controle-financeiro-60807.firebasestorage.app",
            messagingSenderId: "1002617004174",
            appId: "1:1002617004174:web:d3c55c61dd5ca19b2d29df"
        };

        // Inicializar Firebase
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();
        const auth = firebase.auth();

        // ============================================================
        //  JAVASCRIPT COMPLETO – IMPÉRIO CONTROLE FINANCEIRO
        // ============================================================

        (function() {
            'use strict';

            // ---------- CHAVES DO localStorage ----------
            const STORAGE_LANCAMENTOS = 'imperio_lancamentos';
            const STORAGE_RESERVAS = 'imperio_reservas';
            const STORAGE_CATEGORIAS = 'imperio_categorias';
            const STORAGE_DARKMODE = 'imperio_darkmode';
            const STORAGE_LIMITE_CREDITO = 'imperio_limite_credito';
            const STORAGE_USER = 'imperio_user';

            // ---------- ELEMENTOS DOM ----------
            const saldoEl = document.getElementById('saldoDisponivel');
            const creditoEl = document.getElementById('creditoDisponivel');
            const totalReservasEl = document.getElementById('totalReservas');
            const vencerList = document.getElementById('vencerList');
            const tabelaBody = document.getElementById('tabelaLancamentos');
            const reservasGrid = document.getElementById('reservasGrid');

            // Formulário lançamentos
            const tipoLanc = document.getElementById('tipoLancamento');
            const categoriaLanc = document.getElementById('categoriaLancamento');
            const descLanc = document.getElementById('descLancamento');
            const valorLanc = document.getElementById('valorLancamento');
            const dataLanc = document.getElementById('dataLancamento');
            const parcelasLanc = document.getElementById('parcelasLancamento');
            const btnAdd = document.getElementById('btnAddLancamento');

            // Filtros
            const filtroTipo = document.getElementById('filtroTipo');
            const filtroMes = document.getElementById('filtroMes');
            const filtroCategoria = document.getElementById('filtroCategoria');

            // Categorias
            const novaCategoriaInput = document.getElementById('novaCategoria');
            const btnAddCategoria = document.getElementById('btnAddCategoria');
            const categoriaTags = document.getElementById('categoriaTags');

            // Reservas
            const nomeReserva = document.getElementById('nomeReserva');
            const valorReserva = document.getElementById('valorReserva');
            const dataReserva = document.getElementById('dataReserva');
            const btnAddReserva = document.getElementById('btnAddReserva');

            // Import/Export
            const btnExportarCSV = document.getElementById('btnExportarCSV');
            const fileInput = document.getElementById('fileInput');
            const btnImportarCSV = document.getElementById('btnImportarCSV');

            // Gráfico
            const canvas = document.getElementById('graficoReservas');
            let ctx = canvas.getContext('2d');

            // Dark Mode
            const btnDarkMode = document.getElementById('btnDarkMode');

            // Auth
            const btnAuth = document.getElementById('btnAuth');
            const authStatus = document.getElementById('authStatus');
            const statusDot = document.getElementById('statusDot');
            const statusText = document.getElementById('statusText');

            // Sync
            const btnSyncNow = document.getElementById('btnSyncNow');
            const btnBackupLocal = document.getElementById('btnBackupLocal');
            const syncStatus = document.getElementById('syncStatus');
            const syncSpinner = document.getElementById('syncSpinner');

            // ---------- DADOS ----------
            let lancamentos = [];
            let reservas = [];
            let categorias = [];
            let limiteCredito = 0;
            let currentUser = null;
            let isSyncing = false;
            let isInitialLoad = true;

            // ---------- FUNÇÕES DE CARGA / SALVO ----------
            function carregarDadosLocal() {
                try {
                    const rawL = localStorage.getItem(STORAGE_LANCAMENTOS);
                    lancamentos = rawL ? JSON.parse(rawL) : [];
                } catch (e) { lancamentos = []; }

                try {
                    const rawR = localStorage.getItem(STORAGE_RESERVAS);
                    reservas = rawR ? JSON.parse(rawR) : [];
                } catch (e) { reservas = []; }

                try {
                    const rawC = localStorage.getItem(STORAGE_CATEGORIAS);
                    categorias = rawC ? JSON.parse(rawC) : ['Salário', 'Aluguel', 'Alimentação', 'Transporte', 'Lazer',
                        'Saúde', 'Educação'
                    ];
                } catch (e) {
                    categorias = ['Salário', 'Aluguel', 'Alimentação', 'Transporte', 'Lazer', 'Saúde', 'Educação'];
                }

                try {
                    const rawLc = localStorage.getItem(STORAGE_LIMITE_CREDITO);
                    limiteCredito = rawLc ? parseFloat(rawLc) : 0;
                } catch (e) { limiteCredito = 0; }
            }

            function salvarLancamentosLocal() {
                localStorage.setItem(STORAGE_LANCAMENTOS, JSON.stringify(lancamentos));
            }

            function salvarReservasLocal() {
                localStorage.setItem(STORAGE_RESERVAS, JSON.stringify(reservas));
            }

            function salvarCategoriasLocal() {
                localStorage.setItem(STORAGE_CATEGORIAS, JSON.stringify(categorias));
            }

            function salvarLimiteCreditoLocal() {
                localStorage.setItem(STORAGE_LIMITE_CREDITO, JSON.stringify(limiteCredito));
            }

            function salvarTudoLocal() {
                salvarLancamentosLocal();
                salvarReservasLocal();
                salvarCategoriasLocal();
                salvarLimiteCreditoLocal();
            }

            // ---------- FUNÇÕES DO FIREBASE ----------
            async function carregarDoFirebase() {
                if (!currentUser) return;

                try {
                    syncSpinner.classList.add('active');
                    syncStatus.textContent = 'Sincronizando...';

                    // Buscar lançamentos
                    const lSnapshot = await db.collection('users')
                        .doc(currentUser.uid)
                        .collection('lancamentos')
                        .orderBy('data', 'desc')
                        .get();

                    if (!lSnapshot.empty) {
                        lancamentos = lSnapshot.docs.map(doc => ({
                            id: doc.id,
                            ...doc.data()
                        }));
                    }

                    // Buscar reservas
                    const rSnapshot = await db.collection('users')
                        .doc(currentUser.uid)
                        .collection('reservas')
                        .orderBy('data', 'desc')
                        .get();

                    if (!rSnapshot.empty) {
                        reservas = rSnapshot.docs.map(doc => ({
                            id: doc.id,
                            ...doc.data()
                        }));
                    }

                    // Buscar categorias
                    const cDoc = await db.collection('users')
                        .doc(currentUser.uid)
                        .collection('config')
                        .doc('categorias')
                        .get();

                    if (cDoc.exists && cDoc.data().lista) {
                        categorias = cDoc.data().lista;
                    }

                    // Buscar limite de crédito
                    const lcDoc = await db.collection('users')
                        .doc(currentUser.uid)
                        .collection('config')
                        .doc('limite_credito')
                        .get();

                    if (lcDoc.exists) {
                        limiteCredito = lcDoc.data().valor || 0;
                    }

                    // Salvar localmente
                    salvarTudoLocal();

                    syncStatus.textContent = 'Sincronizado ☁️';
                    syncSpinner.classList.remove('active');

                    // Atualizar interface
                    renderTudo();
                } catch (error) {
                    console.error('Erro ao carregar do Firebase:', error);
                    syncStatus.textContent = 'Erro na sincronização';
                    syncSpinner.classList.remove('active');
                    // Fallback para dados locais
                    carregarDadosLocal();
                    renderTudo();
                }
            }

            async function salvarNoFirebase() {
                if (!currentUser) return;

                try {
                    syncSpinner.classList.add('active');
                    syncStatus.textContent = 'Salvando...';

                    const userRef = db.collection('users').doc(currentUser.uid);

                    // Salvar lançamentos (substituir todos)
                    const lCollection = userRef.collection('lancamentos');
                    const lSnapshot = await lCollection.get();
                    const batch = db.batch();

                    lSnapshot.docs.forEach(doc => {
                        batch.delete(doc.ref);
                    });

                    lancamentos.forEach(l => {
                        const docRef = lCollection.doc(l.id || Date.now().toString());
                        batch.set(docRef, l);
                    });

                    // Salvar reservas
                    const rCollection = userRef.collection('reservas');
                    const rSnapshot = await rCollection.get();
                    rSnapshot.docs.forEach(doc => {
                        batch.delete(doc.ref);
                    });

                    reservas.forEach(r => {
                        const docRef = rCollection.doc(r.id || Date.now().toString());
                        batch.set(docRef, r);
                    });

                    // Salvar categorias
                    const cRef = userRef.collection('config').doc('categorias');
                    batch.set(cRef, { lista: categorias });

                    // Salvar limite de crédito
                    const lcRef = userRef.collection('config').doc('limite_credito');
                    batch.set(lcRef, { valor: limiteCredito });

                    await batch.commit();

                    syncStatus.textContent = 'Sincronizado ☁️';
                    syncSpinner.classList.remove('active');
                } catch (error) {
                    console.error('Erro ao salvar no Firebase:', error);
                    syncStatus.textContent = 'Erro ao salvar';
                    syncSpinner.classList.remove('active');
                    alert('Erro ao sincronizar com o servidor. Verifique sua conexão.');
                }
            }

            async function sincronizar() {
                if (!currentUser) {
                    alert('Faça login para sincronizar seus dados.');
                    return;
                }

                if (isSyncing) return;
                isSyncing = true;

                try {
                    await carregarDoFirebase();
                    await salvarNoFirebase();
                } catch (error) {
                    console.error('Erro na sincronização:', error);
                } finally {
                    isSyncing = false;
                }
            }

            // ---------- AUTENTICAÇÃO ----------
            function atualizarStatusAuth(user) {
                currentUser = user;
                if (user) {
                    statusDot.className = 'dot online';
                    statusText.textContent = user.displayName || user.email || 'Online';
                    btnAuth.textContent = '🚪 Sair';
                    btnAuth.className = 'btn-auth logout';
                    localStorage.setItem(STORAGE_USER, JSON.stringify({
                        uid: user.uid,
                        displayName: user.displayName,
                        email: user.email
                    }));
                    // Carregar dados do Firebase
                    carregarDoFirebase();
                } else {
                    statusDot.className = 'dot offline';
                    statusText.textContent = 'Offline';
                    btnAuth.textContent = '🔑 Entrar com Google';
                    btnAuth.className = 'btn-auth';
                    localStorage.removeItem(STORAGE_USER);
                    syncStatus.textContent = 'Local';
                    // Carregar dados locais
                    carregarDadosLocal();
                    renderTudo();
                }
            }

            function loginGoogle() {
                const provider = new firebase.auth.GoogleAuthProvider();
                auth.signInWithPopup(provider)
                    .then(result => {
                        atualizarStatusAuth(result.user);
                    })
                    .catch(error => {
                        console.error('Erro no login:', error);
                        alert('Erro ao fazer login: ' + error.message);
                    });
            }

            function logout() {
                auth.signOut()
                    .then(() => {
                        atualizarStatusAuth(null);
                    })
                    .catch(error => {
                        console.error('Erro ao sair:', error);
                    });
            }

            // ---------- HELPERS ----------
            function formatarMoeda(v) {
                return 'R$ ' + v.toFixed(2).replace('.', ',');
            }

            function hoje() {
                return new Date().toISOString().slice(0, 10);
            }

            function dataParaStr(d) {
                const dt = new Date(d + 'T00:00:00');
                return dt.toLocaleDateString('pt-BR');
            }

            function gerarParcelas(dataInicio, qtd) {
                const datas = [];
                const dt = new Date(dataInicio + 'T00:00:00');
                for (let i = 0; i < qtd; i++) {
                    const d = new Date(dt);
                    d.setMonth(d.getMonth() + i);
                    datas.push(d.toISOString().slice(0, 10));
                }
                return datas;
            }

            function getTipoLabel(tipo) {
                const map = {
                    'receita': 'Receita',
                    'despesa': 'Despesa',
                    'aumento_limite': '📈 Aumento de Limite',
                    'fatura': '💳 Fatura'
                };
                return map[tipo] || tipo;
            }

            function getTipoBadge(tipo) {
                const map = {
                    'receita': 'badge-receita',
                    'despesa': 'badge-despesa',
                    'aumento_limite': 'badge-aumento',
                    'fatura': 'badge-fatura'
                };
                return map[tipo] || 'badge-despesa';
            }

            // ---------- RENDER: CATEGORIAS ----------
            function renderCategorias() {
                categoriaTags.innerHTML = '';
                categorias.forEach((cat, idx) => {
                    const tag = document.createElement('span');
                    tag.className = 'categoria-tag';
                    tag.innerHTML = `${cat} <span class="remove-cat" data-idx="${idx}">×</span>`;
                    categoriaTags.appendChild(tag);
                });

                const selects = [categoriaLanc, filtroCategoria];
                selects.forEach(sel => {
                    const currentVal = sel.value;
                    sel.innerHTML = '<option value="">Selecione...</option>';
                    categorias.forEach(cat => {
                        const opt = document.createElement('option');
                        opt.value = cat;
                        opt.textContent = cat;
                        sel.appendChild(opt);
                    });
                    if (currentVal && categorias.includes(currentVal)) {
                        sel.value = currentVal;
                    }
                    if (sel === filtroCategoria) {
                        const optAll = document.createElement('option');
                        optAll.value = 'todas';
                        optAll.textContent = 'Todas categorias';
                        sel.prepend(optAll);
                        if (!currentVal || currentVal === 'todas') {
                            sel.value = 'todas';
                        }
                    }
                });

                document.querySelectorAll('.remove-cat').forEach(el => {
                    el.addEventListener('click', function() {
                        const idx = parseInt(this.dataset.idx);
                        if (!isNaN(idx) && idx >= 0 && idx < categorias.length) {
                            const emUso = lancamentos.some(l => l.categoria === categorias[idx]);
                            if (emUso) {
                                alert('Esta categoria está em uso em lançamentos. Remova os lançamentos primeiro ou edite-os.');
                                return;
                            }
                            categorias.splice(idx, 1);
                            salvarCategoriasLocal();
                            renderCategorias();
                            if (currentUser) salvarNoFirebase();
                        }
                    });
                });
            }

            // ---------- RENDER: TUDO ----------
            function renderTudo() {
                renderCategorias();
                renderInicio();
                renderTabela();
                renderReservas();
            }

            // ---------- RENDER: INÍCIO ----------
            function renderInicio() {
                const totalReceitas = lancamentos
                    .filter(l => l.tipo === 'receita')
                    .reduce((s, l) => s + l.valor, 0);
                const totalDespesas = lancamentos
                    .filter(l => l.tipo === 'despesa')
                    .reduce((s, l) => s + l.valor, 0);
                const saldo = totalReceitas - totalDespesas;
                saldoEl.textContent = formatarMoeda(saldo);
                saldoEl.className = 'card-value ' + (saldo >= 0 ? 'positive' : 'negative');

                const aumentos = lancamentos
                    .filter(l => l.tipo === 'aumento_limite')
                    .reduce((s, l) => s + l.valor, 0);
                const faturas = lancamentos
                    .filter(l => l.tipo === 'fatura')
                    .reduce((s, l) => s + l.valor, 0);

                const limiteAtual = limiteCredito + aumentos;
                const utilizado = faturas;
                const credito = Math.max(0, limiteAtual - utilizado);
                creditoEl.textContent = formatarMoeda(credito);
                creditoEl.className = 'card-value ' + (credito > 0 ? 'positive' : credito === 0 ? 'neutral' : 'negative');

                const totalRes = reservas.reduce((s, r) => s + r.valor, 0);
                totalReservasEl.textContent = formatarMoeda(totalRes);

                const hojeStr = hoje();
                const limiteVenc = new Date();
                limiteVenc.setDate(limiteVenc.getDate() + 7);
                const limiteStr = limiteVenc.toISOString().slice(0, 10);

                const proximas = lancamentos
                    .filter(l => l.tipo === 'despesa' && l.parcelas && l.parcelas.length > 0)
                    .flatMap(l => l.parcelas.map((p, idx) => ({
                        desc: l.descricao + (l.parcelas.length > 1 ? ` (${idx+1}/${l.parcelas.length})` : ''),
                        data: p,
                        valor: l.valor / l.parcelas.length
                    })))
                    .filter(item => item.data >= hojeStr && item.data <= limiteStr)
                    .sort((a, b) => a.data.localeCompare(b.data));

                vencerList.innerHTML = '';
                if (proximas.length === 0) {
                    vencerList.innerHTML = '<div class="empty-message">Nenhuma conta próxima do vencimento.</div>';
                } else {
                    proximas.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'vencer-item';
                        div.innerHTML = `
                                <span class="desc">${item.desc}</span>
                                <span class="date">📅 ${dataParaStr(item.data)}</span>
                                <span class="value">${formatarMoeda(item.valor)}</span>
                            `;
                        vencerList.appendChild(div);
                    });
                }
            }

            // ---------- RENDER: TABELA LANÇAMENTOS ----------
            function renderTabela() {
                const tipoFiltro = filtroTipo.value;
                const mesFiltro = filtroMes.value;
                const catFiltro = filtroCategoria.value;

                let filtrados = [...lancamentos];

                if (tipoFiltro !== 'todos') {
                    filtrados = filtrados.filter(l => l.tipo === tipoFiltro);
                }

                if (catFiltro !== 'todas' && catFiltro) {
                    filtrados = filtrados.filter(l => l.categoria === catFiltro);
                }

                if (mesFiltro) {
                    const [ano, mes] = mesFiltro.split('-').map(Number);
                    filtrados = filtrados.filter(l => {
                        const d = new Date(l.data + 'T00:00:00');
                        return d.getFullYear() === ano && (d.getMonth() + 1) === mes;
                    });
                }

                filtrados.sort((a, b) => b.data.localeCompare(a.data));

                tabelaBody.innerHTML = '';
                if (filtrados.length === 0) {
                    tabelaBody.innerHTML =
                        '<tr><td colspan="7" style="text-align:center; color:var(--text-light);">Nenhum lançamento encontrado.</td></tr>';
                    return;
                }

                filtrados.forEach((l, idx) => {
                    const tr = document.createElement('tr');
                    const totalParcelas = l.parcelas ? l.parcelas.length : 1;
                    const valorParcela = l.valor / totalParcelas;

                    const tipoLabel = getTipoLabel(l.tipo);
                    const badgeClass = getTipoBadge(l.tipo);

                    tr.innerHTML = `
                            <td>${dataParaStr(l.data)}</td>
                            <td>${l.descricao}</td>
                            <td><span class="badge ${badgeClass}">${tipoLabel}</span></td>
                            <td>${l.categoria || '-'}</td>
                            <td class="${l.tipo === 'receita' ? 'text-success' : l.tipo === 'aumento_limite' ? 'text-info' : l.tipo === 'fatura' ? 'text-warning' : 'text-danger'} fw-bold">${formatarMoeda(l.valor)}</td>
                            <td>${totalParcelas}x ${formatarMoeda(valorParcela)}</td>
                            <td><button class="btn btn-danger btn-sm" data-idx="${idx}">🗑️</button></td>
                        `;
                    tabelaBody.appendChild(tr);

                    tr.querySelector('button').addEventListener('click', function() {
                        const realIdx = lancamentos.indexOf(l);
                        if (realIdx !== -1) {
                            lancamentos.splice(realIdx, 1);
                            salvarLancamentosLocal();
                            renderTabela();
                            renderInicio();
                            if (currentUser) salvarNoFirebase();
                        }
                    });
                });
            }

            // ---------- RENDER: RESERVAS ----------
            function renderReservas() {
                reservasGrid.innerHTML = '';
                if (reservas.length === 0) {
                    reservasGrid.innerHTML =
                        '<div class="empty-message" style="grid-column:1/-1;">Nenhuma reserva cadastrada.</div>';
                    return;
                }

                const sorted = [...reservas].sort((a, b) => b.data.localeCompare(a.data));

                sorted.forEach(r => {
                    const div = document.createElement('div');
                    div.className = 'reserva-card';
                    div.innerHTML = `
                            <div class="name">${r.nome}</div>
                            <div class="value">${formatarMoeda(r.valor)}</div>
                            <div class="date">📅 ${dataParaStr(r.data)}</div>
                        `;
                    reservasGrid.appendChild(div);
                });

                desenharGrafico();
            }

            // ---------- GRÁFICO ----------
            function desenharGrafico() {
                const sorted = [...reservas].sort((a, b) => a.data.localeCompare(b.data));
                const labels = sorted.map(r => dataParaStr(r.data) + ' - ' + r.nome);
                const valores = sorted.map(r => r.valor);

                const rect = canvas.parentElement.getBoundingClientRect();
                const w = rect.width || 600;
                const h = 260;
                canvas.width = w * 2;
                canvas.height = h * 2;
                canvas.style.width = w + 'px';
                canvas.style.height = h + 'px';
                ctx.scale(2, 2);

                const padding = { top: 20, bottom: 40, left: 50, right: 20 };
                const chartW = w - padding.left - padding.right;
                const chartH = h - padding.top - padding.bottom;

                const maxVal = Math.max(...valores, 100);
                const minVal = Math.min(...valores, 0);

                ctx.clearRect(0, 0, w, h);

                const isDark = document.body.classList.contains('dark-mode');
                ctx.fillStyle = isDark ? '#2d2d44' : '#fafbfc';
                ctx.fillRect(0, 0, w, h);

                ctx.fillStyle = isDark ? '#adb5bd' : '#495057';
                ctx.font = '12px "Segoe UI", sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('Evolução das reservas (R$)', w / 2, 14);

                ctx.strokeStyle = isDark ? '#4d4d6e' : '#dee2e6';
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.moveTo(padding.left, padding.top);
                ctx.lineTo(padding.left, padding.top + chartH);
                ctx.lineTo(padding.left + chartW, padding.top + chartH);
                ctx.stroke();

                const steps = 5;
                for (let i = 0; i <= steps; i++) {
                    const y = padding.top + chartH - (i / steps) * chartH;
                    const val = minVal + (i / steps) * (maxVal - minVal);
                    ctx.fillStyle = isDark ? '#868e96' : '#868e96';
                    ctx.font = '10px sans-serif';
                    ctx.textAlign = 'right';
                    ctx.fillText('R$' + val.toFixed(0), padding.left - 6, y + 4);
                    ctx.strokeStyle = isDark ? '#3d3d5c' : '#edf2f7';
                    ctx.lineWidth = 0.5;
                    ctx.beginPath();
                    ctx.moveTo(padding.left, y);
                    ctx.lineTo(padding.left + chartW, y);
                    ctx.stroke();
                }

                if (valores.length === 0) {
                    ctx.fillStyle = isDark ? '#868e96' : '#adb5bd';
                    ctx.font = '14px "Segoe UI", sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText('Sem dados para exibir', w / 2, h / 2);
                    return;
                }

                if (valores.length < 2) {
                    const x = padding.left + chartW / 2;
                    const y = padding.top + chartH - ((valores[0] - minVal) / (maxVal - minVal)) * chartH;
                    ctx.fillStyle = '#2ecc71';
                    ctx.beginPath();
                    ctx.arc(x, y, 6, 0, 2 * Math.PI);
                    ctx.fill();
                    ctx.fillStyle = isDark ? '#e9ecef' : '#1a1a2e';
                    ctx.font = '11px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText(formatarMoeda(valores[0]), x, y - 12);
                    return;
                }

                ctx.strokeStyle = '#2ecc71';
                ctx.lineWidth = 2.5;
                ctx.beginPath();

                for (let i = 0; i < valores.length; i++) {
                    const x = padding.left + (i / (valores.length - 1)) * chartW;
                    const y = padding.top + chartH - ((valores[i] - minVal) / (maxVal - minVal)) * chartH;
                    if (i === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.stroke();

                for (let i = 0; i < valores.length; i++) {
                    const x = padding.left + (i / (valores.length - 1)) * chartW;
                    const y = padding.top + chartH - ((valores[i] - minVal) / (maxVal - minVal)) * chartH;
                    ctx.fillStyle = '#2ecc71';
                    ctx.beginPath();
                    ctx.arc(x, y, 5, 0, 2 * Math.PI);
                    ctx.fill();
                    ctx.fillStyle = isDark ? '#e9ecef' : '#1a1a2e';
                    ctx.font = '9px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText('R$' + valores[i].toFixed(0), x, y - 10);
                }

                const stepLabel = Math.max(1, Math.floor(valores.length / 6));
                ctx.fillStyle = isDark ? '#868e96' : '#868e96';
                ctx.font = '9px sans-serif';
                ctx.textAlign = 'center';
                for (let i = 0; i < valores.length; i += stepLabel) {
                    const x = padding.left + (i / (valores.length - 1)) * chartW;
                    const label = labels[i] || '';
                    ctx.fillText(label.slice(0, 12), x, padding.top + chartH + 16);
                }
            }

            // ---------- ADICIONAR LANÇAMENTO ----------
            function adicionarLancamento() {
                const tipo = tipoLanc.value;
                const categoria = categoriaLanc.value;
                const desc = descLanc.value.trim();
                const valor = parseFloat(valorLanc.value);
                const data = dataLanc.value;
                const parcelas = parseInt(parcelasLanc.value) || 1;

                if (!desc) { alert('Informe uma descrição.'); return; }
                if (isNaN(valor) || valor <= 0) { alert('Informe um valor válido.'); return; }
                if (!data) { alert('Informe a data.'); return; }

                if (tipo === 'fatura' && parcelas > 1) {
                    if (!confirm('Faturas geralmente não são parceladas. Deseja continuar com ' + parcelas +
                            ' parcelas?')) {
                        return;
                    }
                }

                const parcelasDatas = gerarParcelas(data, parcelas);

                lancamentos.push({
                    id: Date.now().toString() + Math.random().toString(36).substr(2, 4),
                    tipo: tipo,
                    categoria: categoria || 'Sem categoria',
                    descricao: desc,
                    valor: valor,
                    data: data,
                    parcelas: parcelasDatas,
                    criadoEm: new Date().toISOString()
                });

                if (tipo === 'aumento_limite') {
                    limiteCredito += valor;
                    salvarLimiteCreditoLocal();
                }

                salvarLancamentosLocal();

                descLanc.value = '';
                valorLanc.value = '';
                dataLanc.value = '';
                parcelasLanc.value = '1';
                tipoLanc.value = 'receita';

                renderTudo();
                if (currentUser) salvarNoFirebase();
            }

            // ---------- ADICIONAR RESERVA ----------
            function adicionarReserva() {
                const nome = nomeReserva.value.trim();
                const valor = parseFloat(valorReserva.value);
                const data = dataReserva.value;

                if (!nome) { alert('Informe o nome da reserva.'); return; }
                if (isNaN(valor) || valor <= 0) { alert('Informe um valor válido.'); return; }
                if (!data) { alert('Informe a data.'); return; }

                reservas.push({
                    id: Date.now().toString() + Math.random().toString(36).substr(2, 4),
                    nome: nome,
                    valor: valor,
                    data: data,
                    criadoEm: new Date().toISOString()
                });

                salvarReservasLocal();

                nomeReserva.value = '';
                valorReserva.value = '';
                dataReserva.value = '';

                renderTudo();
                if (currentUser) salvarNoFirebase();
            }

            // ---------- ADICIONAR CATEGORIA ----------
            function adicionarCategoria() {
                const nome = novaCategoriaInput.value.trim();
                if (!nome) { alert('Digite um nome para a categoria.'); return; }
                if (categorias.includes(nome)) { alert('Esta categoria já existe.'); return; }

                categorias.push(nome);
                salvarCategoriasLocal();
                novaCategoriaInput.value = '';
                renderTudo();
                if (currentUser) salvarNoFirebase();
            }

            // ---------- EXPORTAR CSV ----------
            function exportarCSV() {
                if (lancamentos.length === 0) {
                    alert('Nenhum lançamento para exportar.');
                    return;
                }

                const headers = ['Data', 'Descrição', 'Tipo', 'Categoria', 'Valor', 'Parcelas'];
                const rows = lancamentos.map(l => {
                    const totalParcelas = l.parcelas ? l.parcelas.length : 1;
                    const parcelasStr = l.parcelas ? l.parcelas.join('|') : '';
                    return [
                        l.data,
                        l.descricao,
                        l.tipo,
                        l.categoria || '',
                        l.valor,
                        parcelasStr
                    ];
                });

                const csvContent = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');

                const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = `lancamentos_${hoje()}.csv`;
                link.click();
                URL.revokeObjectURL(link.href);
            }

            // ---------- IMPORTAR CSV ----------
            function importarCSV() {
                const file = fileInput.files[0];
                if (!file) {
                    alert('Selecione um arquivo CSV.');
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        const text = e.target.result;
                        const lines = text.split('\n').filter(line => line.trim());

                        if (lines.length < 2) {
                            alert('Arquivo vazio ou formato inválido.');
                            return;
                        }

                        const dataLines = lines.slice(1);
                        let importados = 0;

                        dataLines.forEach(line => {
                            const cols = line.split(',').map(c => c.trim());
                            if (cols.length < 6) return;

                            const [data, descricao, tipo, categoria, valorStr, parcelasStr] = cols;

                            if (!data || !descricao || !tipo || !valorStr) return;

                            const valor = parseFloat(valorStr);
                            if (isNaN(valor) || valor <= 0) return;

                            const parcelas = parcelasStr ? parcelasStr.split('|') : [data];

                            lancamentos.push({
                                id: Date.now().toString() + Math.random().toString(36).substr(2, 4),
                                tipo: tipo,
                                categoria: categoria || 'Sem categoria',
                                descricao: descricao,
                                valor: valor,
                                data: data,
                                parcelas: parcelas,
                                criadoEm: new Date().toISOString()
                            });

                            importados++;
                        });

                        salvarLancamentosLocal();
                        fileInput.value = '';
                        renderTudo();
                        if (currentUser) salvarNoFirebase();
                        alert(`✅ ${importados} lançamentos importados com sucesso!`);
                    } catch (err) {
                        alert('Erro ao importar arquivo. Verifique o formato.');
                        console.error(err);
                    }
                };
                reader.readAsText(file, 'UTF-8');
            }

            // ---------- BACKUP LOCAL ----------
            function fazerBackupLocal() {
                const backup = {
                    lancamentos: lancamentos,
                    reservas: reservas,
                    categorias: categorias,
                    limiteCredito: limiteCredito,
                    dataBackup: new Date().toISOString()
                };

                const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = `backup_imperio_${hoje()}.json`;
                link.click();
                URL.revokeObjectURL(link.href);
                alert('✅ Backup local criado com sucesso!');
            }

            // ---------- DARK MODE ----------
            function toggleDarkMode() {
                document.body.classList.toggle('dark-mode');
                const isDark = document.body.classList.contains('dark-mode');
                btnDarkMode.textContent = isDark ? '☀️' : '🌙';
                localStorage.setItem(STORAGE_DARKMODE, isDark);
                setTimeout(desenharGrafico, 100);
            }

            // ---------- TABS ----------
            function initTabs() {
                const btns = document.querySelectorAll('.tab-btn');
                const contents = document.querySelectorAll('.tab-content');

                btns.forEach(btn => {
                    btn.addEventListener('click', function() {
                        btns.forEach(b => b.classList.remove('active'));
                        contents.forEach(c => c.classList.remove('active'));
                        this.classList.add('active');
                        document.getElementById(this.dataset.tab).classList.add('active');

                        if (this.dataset.tab === 'tab3') {
                            setTimeout(desenharGrafico, 100);
                        }
                    });
                });
            }

            // ---------- EVENTOS ----------
            btnAdd.addEventListener('click', adicionarLancamento);
            btnAddReserva.addEventListener('click', adicionarReserva);
            btnAddCategoria.addEventListener('click', adicionarCategoria);
            btnExportarCSV.addEventListener('click', exportarCSV);
            btnImportarCSV.addEventListener('click', importarCSV);
            btnDarkMode.addEventListener('click', toggleDarkMode);
            btnAuth.addEventListener('click', function() {
                if (currentUser) {
                    logout();
                } else {
                    loginGoogle();
                }
            });
            btnSyncNow.addEventListener('click', sincronizar);
            btnBackupLocal.addEventListener('click', fazerBackupLocal);

            novaCategoriaInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') adicionarCategoria();
            });

            valorReserva.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') adicionarReserva();
            });

            valorLanc.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') adicionarLancamento();
            });

            filtroTipo.addEventListener('change', renderTabela);
            filtroMes.addEventListener('change', renderTabela);
            filtroCategoria.addEventListener('change', renderTabela);

            document.getElementById('btnLimparFiltros').addEventListener('click', function() {
                filtroTipo.value = 'todos';
                filtroMes.value = '';
                filtroCategoria.value = 'todas';
                renderTabela();
            });

            // ---------- AUTH STATE ----------
            auth.onAuthStateChanged(function(user) {
                if (user) {
                    atualizarStatusAuth(user);
                } else {
                    // Verificar se há usuário salvo
                    const savedUser = localStorage.getItem(STORAGE_USER);
                    if (savedUser) {
                        try {
                            const userData = JSON.parse(savedUser);
                            // Tentar login automático (apenas para exibir nome)
                            statusDot.className = 'dot offline';
                            statusText.textContent = userData.displayName || userData.email || 'Offline';
                            btnAuth.textContent = '🚪 Sair';
                            btnAuth.className = 'btn-auth logout';
                            // Tentar reconectar
                            auth.signInWithCustomToken(userData.uid).catch(() => {});
                        } catch (e) {}
                    }
                    atualizarStatusAuth(null);
                }
            });

            // ---------- INICIALIZAÇÃO ----------
            function init() {
                document.getElementById('headerDate').textContent =
                    new Date().toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long',
                        year: 'numeric' });

                // Dark mode
                const dark = localStorage.getItem(STORAGE_DARKMODE);
                if (dark === 'true') {
                    document.body.classList.add('dark-mode');
                    btnDarkMode.textContent = '☀️';
                }

                // Carregar dados locais primeiro
                carregarDadosLocal();

                // Verificar se há usuário salvo
                const savedUser = localStorage.getItem(STORAGE_USER);
                if (savedUser) {
                    try {
                        const userData = JSON.parse(savedUser);
                        statusDot.className = 'dot offline';
                        statusText.textContent = userData.displayName || userData.email || 'Offline';
                        btnAuth.textContent = '🚪 Sair';
                        btnAuth.className = 'btn-auth logout';
                    } catch (e) {}
                }

                initTabs();
                renderTudo();

                setTimeout(desenharGrafico, 300);

                let resizeTimer;
                window.addEventListener('resize', function() {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(desenharGrafico, 200);
                });

                // Sincronizar automaticamente após carregar
                setTimeout(() => {
                    if (currentUser) {
                        sincronizar();
                    }
                }, 1000);
            }

            init();

            // Expor funções para debug
            window._debug = {
                lancamentos: () => lancamentos,
                reservas: () => reservas,
                categorias: () => categorias,
                user: () => currentUser,
                sync: sincronizar,
                backup: fazerBackupLocal
            };

        })();
    </script>

</body>
