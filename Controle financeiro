<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Império - Controle Financeiro</title>
    
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>

    <style>
        /* ============================
                   RESET E ESTILOS GERAIS
                ============================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        :root {
            --bg-primary: #f0f2f5;
            --bg-secondary: #ffffff;
            --bg-card: #ffffff;
            --bg-input: #ffffff;
            --text-primary: #1a1a2e;
            --text-secondary: #6c757d;
            --text-light: #868e96;
            --border-color: #edf2f7;
            --border-input: #dee2e6;
            --shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
            --shadow-hover: 0 4px 20px rgba(0, 0, 0, 0.08);
            --tab-bg: #f1f3f5;
            --badge-receita-bg: #d4edda;
            --badge-receita-text: #155724;
            --badge-despesa-bg: #f8d7da;
            --badge-despesa-text: #721c24;
            --badge-aumento-bg: #cce5ff;
            --badge-aumento-text: #004085;
            --badge-fatura-bg: #fff3cd;
            --badge-fatura-text: #856404;
            --btn-google-bg: #4285F4;
            --btn-google-hover: #357ae8;
        }

        body.dark-mode {
            --bg-primary: #1a1a2e;
            --bg-secondary: #2d2d44;
            --bg-card: #2d2d44;
            --bg-input: #3d3d5c;
            --text-primary: #e9ecef;
            --text-secondary: #adb5bd;
            --text-light: #868e96;
            --border-color: #3d3d5c;
            --border-input: #4d4d6e;
            --shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
            --shadow-hover: 0 4px 20px rgba(0, 0, 0, 0.3);
            --tab-bg: #2d2d44;
            --badge-receita-bg: #1e4620;
            --badge-receita-text: #8fdf9f;
            --badge-despesa-bg: #4a1a1a;
            --badge-despesa-text: #f8a0a0;
            --badge-aumento-bg: #1a2a4a;
            --badge-aumento-text: #8fcbff;
            --badge-fatura-bg: #4a3a1a;
            --badge-fatura-text: #ffd980;
        }

        body {
            background: var(--bg-primary);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            padding: 20px;
            transition: background 0.3s, color 0.3s;
        }

        .app-container {
            max-width: 1200px;
            width: 100%;
            background: var(--bg-secondary);
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            padding: 24px 28px 40px;
            transition: background 0.3s;
        }

        /* ============================
                   HEADER
                ============================ */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 28px;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 16px;
            transition: border-color 0.3s;
        }

        .header h1 {
            font-size: 26px;
            color: var(--text-primary);
            font-weight: 700;
            letter-spacing: -0.5px;
            transition: color 0.3s;
        }

        .header h1 span {
            color: #2ecc71;
        }

        .header-actions {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .header-date {
            color: var(--text-secondary);
            font-size: 14px;
            background: var(--tab-bg);
            padding: 6px 16px;
            border-radius: 30px;
            transition: background 0.3s, color 0.3s;
        }

        .btn-darkmode {
            background: var(--tab-bg);
            border: 1px solid var(--border-color);
            border-radius: 30px;
            padding: 6px 14px;
            cursor: pointer;
            font-size: 18px;
            transition: 0.2s;
            color: var(--text-primary);
        }

        .btn-darkmode:hover {
            transform: scale(1.05);
        }

        .btn-auth {
            background: var(--btn-google-bg);
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 30px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-auth:hover {
            background: var(--btn-google-hover);
            transform: scale(1.02);
        }

        .btn-auth.logout {
            background: #e74c3c;
        }

        .btn-auth.logout:hover {
            background: #c0392b;
        }

        .auth-status {
            font-size: 13px;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .auth-status .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
        }

        .auth-status .dot.online {
            background: #2ecc71;
        }
        .auth-status .dot.offline {
            background: #e74c3c;
        }

        /* ============================
                   TABS (ABAS)
                ============================ */
        .tabs {
            display: flex;
            gap: 6px;
            margin-bottom: 28px;
            background: var(--tab-bg);
            padding: 6px;
            border-radius: 16px;
            transition: background 0.3s;
        }

        .tab-btn {
            flex: 1;
            padding: 12px 0;
            border: none;
            background: transparent;
            font-size: 15px;
            font-weight: 600;
            color: var(--text-secondary);
            border-radius: 12px;
            cursor: pointer;
            transition: 0.25s;
        }

        .tab-btn:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .tab-btn.active {
            background: var(--bg-secondary);
            color: var(--text-primary);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .tab-content {
            display: none;
            animation: fade 0.3s ease;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fade {
            0% {
                opacity: 0.4;
                transform: translateY(6px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ============================
                   CARDS (PÁGINA INICIAL)
                ============================ */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 18px;
            margin-bottom: 32px;
        }

        .card {
            background: var(--bg-card);
            border-radius: 18px;
            padding: 20px 22px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            transition: 0.2s;
        }

        .card:hover {
            border-color: #2ecc71;
            box-shadow: var(--shadow-hover);
        }

        .card-label {
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            color: var(--text-light);
            margin-bottom: 6px;
            transition: color 0.3s;
        }

        .card-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--text-primary);
            transition: color 0.3s;
        }

        .card-value.positive {
            color: #2ecc71;
        }
        .card-value.negative {
            color: #e74c3c;
        }
        .card-value.neutral {
            color: #f39c12;
        }

        .card-sub {
            font-size: 13px;
            color: var(--text-light);
            margin-top: 4px;
            transition: color 0.3s;
        }

        /* ============================
                   CONTAS A VENCER
                ============================ */
        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: color 0.3s;
        }

        .section-title small {
            font-weight: 400;
            font-size: 14px;
            color: var(--text-light);
        }

        .vencer-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .vencer-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--bg-card);
            padding: 12px 18px;
            border-radius: 12px;
            border-left: 4px solid #e74c3c;
            flex-wrap: wrap;
            border: 1px solid var(--border-color);
            transition: background 0.3s, border-color 0.3s;
        }

        .vencer-item .desc {
            font-weight: 500;
            color: var(--text-primary);
        }
        .vencer-item .date {
            color: var(--text-secondary);
            font-size: 14px;
        }
        .vencer-item .value {
            font-weight: 600;
            color: #e74c3c;
        }

        .empty-message {
            color: var(--text-light);
            font-size: 15px;
            padding: 20px 0;
            text-align: center;
        }

        /* ============================
                   FORMULÁRIO (ABA CONTROLE)
                ============================ */
        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 14px;
            margin-bottom: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
            transition: color 0.3s;
        }

        .form-group input,
        .form-group select {
            padding: 10px 14px;
            border-radius: 10px;
            border: 1.5px solid var(--border-input);
            font-size: 14px;
            background: var(--bg-input);
            color: var(--text-primary);
            transition: 0.2s, background 0.3s, color 0.3s, border-color 0.3s;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #2ecc71;
            box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.15);
        }

        .form-group input::placeholder {
            color: var(--text-light);
        }

        .form-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 8px;
        }

        .btn {
            padding: 10px 28px;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-primary {
            background: #2ecc71;
            color: #fff;
        }
        .btn-primary:hover {
            background: #27ae60;
            transform: scale(1.02);
        }

        .btn-danger {
            background: #e74c3c;
            color: #fff;
        }
        .btn-danger:hover {
            background: #c0392b;
        }

        .btn-outline {
            background: transparent;
            border: 1.5px solid var(--border-input);
            color: var(--text-secondary);
        }
        .btn-outline:hover {
            background: var(--tab-bg);
        }

        .btn-success {
            background: #28a745;
            color: #fff;
        }
        .btn-success:hover {
            background: #218838;
        }

        .btn-info {
            background: #17a2b8;
            color: #fff;
        }
        .btn-info:hover {
            background: #138496;
        }

        .btn-sm {
            padding: 6px 16px;
            font-size: 12px;
        }

        .btn-warning {
            background: #ffc107;
            color: #1a1a2e;
        }
        .btn-warning:hover {
            background: #e0a800;
        }

        .btn-sync {
            background: #6f42c1;
            color: #fff;
        }
        .btn-sync:hover {
            background: #5a32a3;
        }
        .btn-sync.synced {
            background: #2ecc71;
        }

        /* ============================
                   TABELA DE LANÇAMENTOS
                ============================ */
        .table-wrapper {
            overflow-x: auto;
            margin-top: 20px;
            border-radius: 14px;
            border: 1px solid var(--border-color);
            transition: border-color 0.3s;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        th {
            background: var(--tab-bg);
            text-align: left;
            padding: 12px 16px;
            font-weight: 600;
            color: var(--text-secondary);
            border-bottom: 2px solid var(--border-color);
            transition: background 0.3s, color 0.3s, border-color 0.3s;
        }

        td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
            color: var(--text-primary);
            transition: border-color 0.3s, color 0.3s;
        }

        tr:hover td {
            background: var(--tab-bg);
        }

        .badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-receita {
            background: var(--badge-receita-bg);
            color: var(--badge-receita-text);
        }
        .badge-despesa {
            background: var(--badge-despesa-bg);
            color: var(--badge-despesa-text);
        }
        .badge-aumento {
            background: var(--badge-aumento-bg);
            color: var(--badge-aumento-text);
        }
        .badge-fatura {
            background: var(--badge-fatura-bg);
            color: var(--badge-fatura-text);
        }

        .text-danger {
            color: #e74c3c;
        }
        .text-success {
            color: #2ecc71;
        }
        .text-warning {
            color: #f39c12;
        }
        .text-info {
            color: #17a2b8;
        }
        .fw-bold {
            font-weight: 600;
        }

        /* ============================
                   ABA RESERVAS
                ============================ */
        .reservas-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin: 18px 0 28px;
        }

        .reserva-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 18px 20px;
            border: 1px solid var(--border-color);
            text-align: center;
            transition: background 0.3s, border-color 0.3s;
        }

        .reserva-card .name {
            font-weight: 600;
            color: var(--text-primary);
            font-size: 16px;
        }
        .reserva-card .value {
            font-size: 22px;
            font-weight: 700;
            color: #2ecc71;
            margin: 4px 0;
        }
        .reserva-card .date {
            font-size: 12px;
            color: var(--text-light);
        }

        .reserva-form {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            align-items: flex-end;
            background: var(--tab-bg);
            padding: 18px 20px;
            border-radius: 16px;
            margin-bottom: 24px;
            transition: background 0.3s;
        }

        .reserva-form .form-group {
            flex: 1;
            min-width: 140px;
        }

        .reserva-form .form-group label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        /* ============================
                   GRÁFICO SIMPLES (canvas)
                ============================ */
        .chart-container {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 20px;
            margin-top: 18px;
            border: 1px solid var(--border-color);
            transition: background 0.3s, border-color 0.3s;
        }

        .chart-container canvas {
            width: 100% !important;
            max-height: 260px;
        }

        /* ============================
                   CATEGORIAS
                ============================ */
        .categoria-form {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: center;
            margin: 12px 0 18px;
            padding: 12px 16px;
            background: var(--tab-bg);
            border-radius: 12px;
            transition: background 0.3s;
        }

        .categoria-form .form-group {
            flex: 1;
            min-width: 140px;
        }

        .categoria-form .btn {
            padding: 8px 20px;
        }

        .categoria-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 8px 0 12px;
        }

        .categoria-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--tab-bg);
            padding: 4px 12px 4px 16px;
            border-radius: 20px;
            font-size: 13px;
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            transition: background 0.3s, color 0.3s, border-color 0.3s;
        }

        .categoria-tag .remove-cat {
            cursor: pointer;
            color: #e74c3c;
            font-weight: 700;
            font-size: 16px;
            line-height: 1;
        }

        .categoria-tag .remove-cat:hover {
            transform: scale(1.2);
        }

        /* ============================
                   IMPORTAÇÃO/EXPORTAÇÃO
                ============================ */
        .import-export-area {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin: 16px 0 20px;
            padding: 16px;
            background: var(--tab-bg);
            border-radius: 14px;
            align-items: center;
            transition: background 0.3s;
        }

        .import-export-area .form-group {
            flex: 0 0 auto;
        }

        .import-export-area input[type="file"] {
            padding: 8px;
            border-radius: 8px;
            border: 1px solid var(--border-input);
            background: var(--bg-input);
            color: var(--text-primary);
            max-width: 200px;
        }

        /* ============================
                   SYNC STATUS BAR
                ============================ */
        .sync-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 16px;
            background: var(--tab-bg);
            border-radius: 12px;
            margin-bottom: 16px;
            transition: background 0.3s;
            flex-wrap: wrap;
            gap: 8px;
        }

        .sync-bar .status {
            font-size: 13px;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sync-bar .status .spinner {
            width: 16px;
            height: 16px;
            border: 2px solid var(--border-color);
            border-top-color: #2ecc71;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            display: none;
        }

        .sync-bar .status .spinner.active {
            display: inline-block;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ============================
                   RESPONSIVO
                ============================ */
        @media (max-width: 600px) {
            .app-container {
                padding: 16px;
            }
            .header h1 {
                font-size: 20px;
            }
            .card-value {
                font-size: 22px;
            }
            .form-row {
                grid-template-columns: 1fr;
            }
            .vencer-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 4px;
            }
            .tabs .tab-btn {
                font-size: 13px;
                padding: 10px 0;
            }
            .header-actions {
                width: 100%;
                justify-content: space-between;
                margin-top: 8px;
            }
            .import-export-area {
                flex-direction: column;
                align-items: stretch;
            }
            .import-export-area input[type="file"] {
                max-width: 100%;
            }
            .sync-bar {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
            }
            .btn-auth {
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <div class="app-container" id="app">

        <!-- ============================
        HEADER
        ============================ -->
        <header class="header">
            <h1>👑 <span>Império</span> - Controle Financeiro</h1>
            <div class="header-actions">
                <div class="header-date" id="headerDate"></div>
                <div class="auth-status" id="authStatus">
                    <span class="dot offline" id="statusDot"></span>
                    <span id="statusText">Offline</span>
                </div>
                <button class="btn-auth" id="btnAuth">🔑 Entrar com Google</button>
                <button class="btn-darkmode" id="btnDarkMode" title="Alternar tema">🌙</button>
            </div>
        </header>

        <!-- ============================
        SYNC STATUS BAR
        ============================ -->
        <div class="sync-bar">
            <div class="status">
                <span>📡 Sincronização:</span>
                <span id="syncStatus">Local</span>
                <span class="spinner" id="syncSpinner"></span>
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <button class="btn btn-sync btn-sm" id="btnSyncNow">🔄 Sincronizar agora</button>
                <button class="btn btn-success btn-sm" id="btnBackupLocal">💾 Backup Local</button>
            </div>
        </div>

        <!-- ============================
        TABS
        ============================ -->
        <div class="tabs">
            <button class="tab-btn active" data-tab="tab1">📊 Início</button>
            <button class="tab-btn" data-tab="tab2">✏️ Controle</button>
            <button class="tab-btn" data-tab="tab3">🏦 Reservas</button>
        </div>

        <!-- ============================
        ABA 1 – INÍCIO
        ============================ -->
        <div class="tab-content active" id="tab1">

            <div class="cards-grid">
                <div class="card">
                    <div class="card-label">💰 Saldo disponível</div>
                    <div class="card-value positive" id="saldoDisponivel">R$ 0,00</div>
                    <div class="card-sub">Receitas - Despesas</div>
                </div>
                <div class="card">
                    <div class="card-label">💳 Crédito disponível</div>
                    <div class="card-value neutral" id="creditoDisponivel">R$ 0,00</div>
                    <div class="card-sub">Limite - Utilizado</div>
                </div>
                <div class="card">
                    <div class="card-label">🏦 Reserva financeira</div>
                    <div class="card-value positive" id="totalReservas">R$ 0,00</div>
                    <div class="card-sub">Total em reservas</div>
                </div>
            </div>

            <div class="section-title">
                📅 Contas a vencer (próximos 7 dias)
                <small>— fique atento!</small>
            </div>
            <div class="vencer-list" id="vencerList">
